# ==========================================
# Rozmaly — Environment Variables
# ==========================================
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local". It is already in .gitignore.

# ---- MongoDB ----
# Local example:  mongodb://localhost:27017/rozmaly
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rozmaly?retryWrites=true&w=majority
MONGODB_URI=

# ---- App ----
# Public site URL (used for secure cookie attributes & CORS/origin checks).
APP_URL=http://localhost:3000
# Secret used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ---- First admin (used only by the seed script) ----
ADMIN_NAME=مدير روزماري
ADMIN_EMAIL=
ADMIN_PASSWORD=
# رمز من 4 أرقام لاستعادة كلمة مرور الأدمن من داخل الداشبورد
ADMIN_RESET_PIN=

# ---- WhatsApp order alerts for the manager (optional, free) ----
# Uses CallMeBot (api.callmebot.com). One-time setup by the manager:
#   1. Visit https://www.callmebot.com/blog/free-api-whatsapp-messages/
#      and follow the steps (save their number, send the activation message).
#   2. They reply with an apikey for the manager's number.
#   3. Put the manager's number (international, e.g. 201001234567) and the key.
WHATSAPP_MANAGER_PHONE=
CALLMEBOT_APIKEY=

# ---- Cloudinary (image storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Cloudinary upload preset name (unsigned), leave empty to use signed uploads.
# CLOUDINARY_UPLOAD_PRESET=
