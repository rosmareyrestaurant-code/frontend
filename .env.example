# ==========================================
# Rosemary Project - Environment Variables
# ==========================================

# قاعدة بيانات MongoDB (استبدل الرابط برابط قاعدة البيانات الخاصة بك)
# مثال محلي: mongodb://localhost:27017/rosemary
# مثال سحابي (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/rosemary?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/rosemary

# رابط التطبيق
NEXT_PUBLIC_APP_URL=http://localhost:3000
